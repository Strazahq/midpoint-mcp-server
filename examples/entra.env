# midpoint-mcp-server in shared mode, with Microsoft Entra ID as the identity provider.
# See docs/identity-providers.md for the Entra and midPoint side of this setup.
# Replace every <placeholder>. Then load this file with docker run --env-file or a
# systemd EnvironmentFile, and start the server behind a TLS proxy with:
#   midpoint-mcp-server --http 0.0.0.0:3001
# Each setting has one comment line above it that says why it has this value.

# The midPoint deployment root over https, so the service account's password travels encrypted.
MIDPOINT_URL=https://<midpoint-host>/midpoint
# The dedicated service account that holds the rs-service role and the correlation read authorization.
MIDPOINT_USERNAME=<service-account-name>
# MIDPOINT_PASSWORD is deliberately not set here. Inject it into the server's environment at runtime from your secret store.
# Off, because certificate checks toward midPoint protect the service account's password.
MIDPOINT_INSECURE_TLS=false
# Off, so write tools return previews until you decide the assistant may change midPoint.
MIDPOINT_MCP_ALLOW_WRITES=false
# Empty, because this setup keeps every default of the optional settings file that the README describes.
MIDPOINT_MCP_CONFIG=
# The tenant's version 2 issuer, because the server's registration sets requestedAccessTokenVersion to 2.
MIDPOINT_MCP_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# The server registration's application (client) id, because version 2 tokens always carry it in aud.
MIDPOINT_MCP_OIDC_AUDIENCE=<server-client-id>
# Empty, because the server reaches Entra's discovery document at the issuer's own address.
MIDPOINT_MCP_OIDC_DISCOVERY_URL=
# The immutable Entra object id, the same value Microsoft Graph returns as the user's id.
MIDPOINT_MCP_OIDC_CORRELATION_CLAIM=oid
# The extension item that midPoint's inbound mapping fills from the Entra account's id, and nothing else writes.
MIDPOINT_MCP_OIDC_CORRELATION_ATTRIBUTE=extension/entraObjectId
# Empty, because Entra has no claim that only app-only tokens carry and that also names the client.
MIDPOINT_MCP_OIDC_CLIENT_CORRELATION_CLAIM=
# Empty, because the server requires it to be set exactly when the client claim is set.
MIDPOINT_MCP_OIDC_CLIENT_ARCHETYPES=
# Off, so a caller without a token cannot even list the tools.
MIDPOINT_MCP_ANONYMOUS_DISCOVERY=false
