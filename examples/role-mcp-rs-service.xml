<?xml version="1.0" encoding="UTF-8"?>
<!--
  midPoint MCP server — "rs-service" profile.

  The role for the technical account the server authenticates with in
  RESOURCE-SERVER (OIDC) mode, where every tool call executes as the correlated
  end user via the Switch-To-Principal header.

  Design: the account holds NEAR-ZERO STANDING PRIVILEGE. It gets REST entry for
  the endpoints the tools call, plus the impersonation grant, and of model
  rights only the correlation read and the read of schema definitions. On its own it can read nothing and change nothing; its
  only power is to borrow the authorizations of a bounded set of end users, and
  midPoint attributes every change to the human who asked for it.

  Verified on midPoint 4.10.3 with an account holding exactly this role:
    GET /self + Switch-To-Principal: <employee oid>  -> 200, that employee
    GET /self without the header                     -> 500 Access denied
    POST /users/search without the header            -> 200 with an EMPTY list
    GET /users/<oid> without the header              -> 403
    Switch-To-Principal: <external archetype oid>    -> 403 (outside proxy scope)

  Two facts that surprise people (both verified on 4.10.3):
  - REST authorization is checked against the AUTHENTICATED account even while
    impersonating, so this role must carry the endpoint actions even though it
    carries no model rights.
  - The #proxy action alone grants no REST entry whatsoever: a #proxy-only
    account is 403'd on every endpoint including /self.

  Adjust before importing:
  - the archetypeRef OIDs below, in BOTH the #proxy and the correlation-read
    authorization (they are placeholders for YOUR archetypes);
  - add your correlation attribute to the correlation read if it is not name
    (for example extension/entraObjectId, see docs/identity-providers.md);
  - drop #addObject if you do not want create_user;
  - drop #completeWorkItem if you do not want decide_work_item;
  - drop #claimWorkItem and #releaseWorkItem if no approval step names a group;
  - drop #cancelCase if requesters should not withdraw their own requests. Keep
    it, and the person also needs model #cancelCase on cases they requested;
    midPoint's End user role does not have that (docs/authorization.md);
  - drop the "read-request-fields" authorization and #getObjects and
    #getExtensionSchema if requests should carry no fields. Without them the
    server starts with a warning and the request dialog has no fields.

  Verified on midPoint 4.10.3 (2026-10-04) with exactly this shape (REST
  entry, #proxy, correlation read, no other model rights): impersonated calls
  as a plain End user and as a manager answer 200, correlation finds the user,
  and the account acting as itself is refused (403) when it modifies a user.

  Not included on purpose: rest-3#executeScript. search_audit needs bulk-action
  Groovy, which 4.10 unlocks only for full superusers or via a deployment-wide
  expression profile - and it does not work under impersonation anyway, because
  the impersonated end user has no script authorization. See
  docs/authorization.md -> "The search_audit exception".
-->
<role xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
      oid="11111111-2222-3333-4444-555555550001">
    <name>MCP resource-server service</name>
    <description>
        Technical account role for midpoint-mcp-server in OIDC resource-server mode:
        REST entry plus archetype-scoped impersonation; of its own, only the correlation read
        and the read of schema definitions.
    </description>

    <!--
      REST entry. One action per endpoint the server calls; every other REST verb
      (DELETE, task control, log access, script execution, ...) stays refused at
      the security filter.
        getSelf         GET  /ws/rest/self
        getObject       GET  /ws/rest/{users,roles,resources,cases}/{oid}
        searchObjects   POST /ws/rest/{collection}/search
        addObject       POST /ws/rest/users              (create_user)
        modifyObject    PATCH /ws/rest/users/{oid}       (enable/disable, assign,
                                                          unassign, request, recompute)
        completeWorkItem POST /ws/rest/cases/{oid}/workItems/{id}/complete
        claimWorkItem   POST /ws/rest/cases/{oid}/workItems/{id}/claim   (claim_work_item)
        releaseWorkItem POST /ws/rest/cases/{oid}/workItems/{id}/release (release_work_item)
        cancelCase      POST /ws/rest/cases/{oid}/cancel                (cancel_request, Withdraw)
        getObjects      GET  /ws/rest/schemas                (request fields, at startup)
        getExtensionSchema GET /ws/schema and its files      (request fields, at startup)
      Not included: runTask, suspendTask, resumeTask and testResource (the operator
      tools). Add them only where operators should act from the assistant.
    -->
    <authorization>
        <name>rest-entry</name>
        <description>The REST operations the tools use. Endpoint-level only; object access comes from the impersonated user.</description>
        <action>http://midpoint.evolveum.com/xml/ns/public/security/authorization-rest-3#getSelf</action>
        <action>http://midpoint.evolveum.com/xml/ns/public/security/authorization-rest-3#getObject</action>
        <action>http://midpoint.evolveum.com/xml/ns/public/security/authorization-rest-3#searchObjects</action>
        <action>http://midpoint.evolveum.com/xml/ns/public/security/authorization-rest-3#addObject</action>
        <action>http://midpoint.evolveum.com/xml/ns/public/security/authorization-rest-3#modifyObject</action>
        <action>http://midpoint.evolveum.com/xml/ns/public/security/authorization-rest-3#completeWorkItem</action>
        <action>http://midpoint.evolveum.com/xml/ns/public/security/authorization-rest-3#claimWorkItem</action>
        <action>http://midpoint.evolveum.com/xml/ns/public/security/authorization-rest-3#releaseWorkItem</action>
        <action>http://midpoint.evolveum.com/xml/ns/public/security/authorization-rest-3#cancelCase</action>
        <action>http://midpoint.evolveum.com/xml/ns/public/security/authorization-rest-3#getObjects</action>
        <action>http://midpoint.evolveum.com/xml/ns/public/security/authorization-rest-3#getExtensionSchema</action>
    </authorization>

    <!--
      Impersonation, scoped to the population this integration may act for.
      ObjectSelectorType/archetypeRef is repeatable and OR-ed: an object matches
      if it carries ANY of the listed archetypes. Everything else - administrators,
      contractors, service and personal-agent identities, and any user with no
      archetype - is outside the scope and cannot be impersonated.

      If your deployment does not use archetypes, the alternatives (in decreasing
      order of preference) are: <subtype>, <orgRef> (impersonate only members of
      an org subtree), or a <filter>. A bare <type>UserType</type> means "anyone,
      including every administrator" - do not ship that.
    -->
    <authorization>
        <name>rest-proxy</name>
        <description>Switch-To-Principal, limited to the governable population.</description>
        <action>http://midpoint.evolveum.com/xml/ns/public/security/authorization-rest-3#proxy</action>
        <object>
            <type>UserType</type>
            <!-- REPLACE with your own archetype OIDs, e.g. an "employee" archetype -->
            <archetypeRef oid="11111111-2222-3333-4444-5555555500a1"/>
            <!-- ... and, if machine identities are in scope, e.g. an "ai-agent" archetype -->
            <archetypeRef oid="11111111-2222-3333-4444-5555555500a2"/>
        </object>
    </authorization>

    <!--
      Correlation: the server finds the user a token belongs to by searching as
      this account itself, before it knows whom to impersonate. This is the only
      model right the account holds: read, limited to the same archetypes as
      #proxy and to the items the searches filter on.
    -->
    <authorization>
        <name>read-users-for-correlation</name>
        <description>Lets midpoint-mcp-server find the user a token belongs to.</description>
        <action>http://midpoint.evolveum.com/xml/ns/public/security/authorization-model-3#read</action>
        <object>
            <type>UserType</type>
            <!-- REPLACE with the same archetype OIDs as in rest-proxy -->
            <archetypeRef oid="11111111-2222-3333-4444-5555555500a1"/>
            <archetypeRef oid="11111111-2222-3333-4444-5555555500a2"/>
        </object>
        <item>name</item>
        <item>archetypeRef</item>
        <!-- Add the correlation attribute if it is not name, for example extension/entraObjectId. -->
    </authorization>

    <!--
      Request fields: at startup the server reads midPoint's assignment
      extension schema and the lookup tables its fields name, as this account
      itself, to offer every assignment field in the request dialog the way
      midPoint's own Request access page does. Definitions only, no person's
      data. Verified on 4.10.3 (2026-10-04): with these grants GET /ws/rest/schemas,
      GET /ws/schema and GET /ws/rest/lookupTables/{oid} answer 200; without
      them, 403.
    -->
    <authorization>
        <name>read-request-fields</name>
        <description>Lets midpoint-mcp-server read the assignment schema and its lookup tables.</description>
        <action>http://midpoint.evolveum.com/xml/ns/public/security/authorization-model-3#read</action>
        <object>
            <type>SchemaType</type>
        </object>
        <object>
            <type>LookupTableType</type>
        </object>
    </authorization>
    <authorization>
        <name>read-extension-schema-files</name>
        <action>http://midpoint.evolveum.com/xml/ns/public/security/authorization-model-3#getExtensionSchema</action>
    </authorization>
</role>
