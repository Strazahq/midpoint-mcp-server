# midpoint-mcp-server in shared mode, with Keycloak as the identity provider.
# See docs/identity-providers.md for the Keycloak and midPoint side of this setup.
# Replace every <placeholder>. Then load this file with docker run --env-file or a
# systemd EnvironmentFile, and start the server behind a TLS proxy with:
#   midpoint-mcp-server --http 0.0.0.0:3001
# Each setting has one comment line above it that says why it has this value.

# The midPoint deployment root over https, so the service account's password travels encrypted.
MIDPOINT_URL=https://<midpoint-host>/midpoint
# The dedicated service account that holds the rs-service role and the correlation read authorization.
MIDPOINT_USERNAME=<service-account-name>
# MIDPOINT_PASSWORD is deliberately not set here. Inject it into the server's environment at runtime from your secret store.
# Off, because certificate checks toward midPoint protect the service account's password.
MIDPOINT_INSECURE_TLS=false
# Off, so write tools return previews until you decide the assistant may change midPoint.
MIDPOINT_MCP_ALLOW_WRITES=false
# Empty, because this setup keeps every default of the optional settings file that the README describes.
MIDPOINT_MCP_CONFIG=
# The realm's issuer exactly as it appears in the iss claim of a decoded token.
MIDPOINT_MCP_OIDC_ISSUER=https://<keycloak-host>/realms/<realm>
# The audience that the dedicated client scope adds, and that no other client's tokens carry.
MIDPOINT_MCP_OIDC_AUDIENCE=midpoint-mcp
# Empty, because the server reaches Keycloak at the issuer's own hostname.
MIDPOINT_MCP_OIDC_DISCOVERY_URL=
# The Keycloak username, which midPoint writes from the user's midPoint name.
MIDPOINT_MCP_OIDC_CORRELATION_CLAIM=preferred_username
# midPoint's name, which midPoint keeps unique and which only midPoint changes.
MIDPOINT_MCP_OIDC_CORRELATION_ATTRIBUTE=name
# Keycloak puts client_id only on client credentials tokens, so it marks an agent's own token.
MIDPOINT_MCP_OIDC_CLIENT_CORRELATION_CLAIM=client_id
# The oid of the agent archetype that no person holds, so a client named like a person never runs as that person.
MIDPOINT_MCP_OIDC_CLIENT_ARCHETYPES=<agent-archetype-oid>
# Off, so a caller without a token cannot even list the tools.
MIDPOINT_MCP_ANONYMOUS_DISCOVERY=false
